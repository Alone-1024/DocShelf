{
  "name": "fenlei-docs",
  "version": "1.1.3",
  "private": true,
  "license": "Apache-2.0",
  "author": "Alone-1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-1024/DocShelf.git"
  },
  "homepage": "https://github.com/Alone-1024/DocShelf/releases",
  "description": "DocShelf — 本地文档分类索引与预览（按原路径登记，不复制文件）",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "app": "electron electron/main.cjs",
    "dist": "electron-builder --win",
    "dist:setup": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "build": {
    "appId": "local.docshelf.app",
    "productName": "DocShelf",
    "directories": {
      "output": "release9"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "toolbox.js",
      "package.json",
      "LICENSE",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocShelf",
      "artifactName": "DocShelf-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "DocShelf.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "updateSources": [
    "https://gitee.com/c-get-lay/doc-shelf/raw/master/version.json",
    "https://gitee.com/c-get-lay/doc-shelf/raw/main/version.json",
    "https://raw.githubusercontent.com/Alone-1024/DocShelf/HEAD/version.json"
  ]
}
